{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=sportreplay;Username=sportreplay;Password=sportreplay_dev"
  },
  "Jwt": {
    "Secret": "sportreplay-dev-jwt-secret-key-change-me-32",
    "Issuer": "SportReplay",
    "Audience": "SportReplay",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Storage": {
    "Provider": "Minio",
    "Endpoint": "localhost:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadmin",
    "Bucket": "sportreplay-videos",
    "UseSsl": false,
    "Region": "us-east-1",
    "SignedUrlExpiryMinutes": 15
  },
  "Video": {
    "RetentionDays": 7,
    "MaxClipDurationSeconds": 60,
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "DefaultSegmentDurationSeconds": 6,
    "WorkingDirectory": "./video-work"
  },
  "MercadoPago": {
    "AccessToken": "",
    "WebhookSecret": "",
    "PublicKey": "",
    "NotificationUrl": "http://localhost:5080/api/payments/webhook"
  },
  "WhatsApp": {
    "AccessToken": "",
    "PhoneNumberId": "",
    "BusinessAccountId": "",
    "ApiVersion": "v21.0",
    "VerifyToken": "sportreplay-verify"
  },
  "Encryption": {
    "Key": "sportreplay-dev-encryption-key-32"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8080" ]
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
